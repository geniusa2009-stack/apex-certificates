# Copy to server/.env for local use. Never commit real values.
APEX_ENV=staging
PORT=8080
APEX_VERIFY_HOST=verify.apex.org
APEX_SIGNING_KID=apex-staging-2026-01
APEX_KEY_PROVIDER=env
# Prefer a one-line base64 encoding of the complete PEM on Render.
# Generate locally and inject into the secret manager; NEVER commit real values.
APEX_SIGNING_KEY_B64=
# Existing multiline PEM configuration is still supported when B64 is unset.
APEX_SIGNING_KEY_PEM=
# For APEX_KEY_PROVIDER=gcp-kms:
# APEX_KMS_KEY_VERSION=projects/P/locations/L/keyRings/R/cryptoKeys/K/cryptoKeyVersions/1
APEX_REQUIRE_TOTP=true
APEX_TRUST_PROXY=true
APEX_SIGNER1=G. Ahmed I. Ragab|Founder
APEX_SIGNER2=Asmaa Hassan|Volunteer Program Coordinator
